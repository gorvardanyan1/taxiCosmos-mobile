# Copy to .env (git-ignored) for local work. Cloud builds take these from EAS environment variables instead.
# See docs/environments.md for every variable and which build needs it.

# development | staging | production (EAS sets this per build profile in eas.json)
APP_ENV=development

# Origin of the Laravel backend; the app adds /api/v1. Android emulator: http://10.0.2.2:8000, phone: http://<your-LAN-IP>:8000
API_URL=http://localhost:8000

# The realtime (Socket.io) service. Leave empty until it exists: the app then refreshes over REST. wss:// in staging and production
REALTIME_URL=

# Optional locally; required for production builds
SENTRY_DSN=

# Optional until card payments (M4-T7); must be a publishable pk_test_ key outside production
STRIPE_PUBLISHABLE_KEY=

# Map tiles, e.g. https://tiles.example.com/{z}/{x}/{y}.png. Empty uses OpenStreetMap's public server (development only)
MAP_TILE_URL=
