    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --coverage"
  },
  "devDependencies": {
    "@expo/config-types": "~57.0.2",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "babel-preset-expo": "~57.0.16",
    "jest": "29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.15"
  }
