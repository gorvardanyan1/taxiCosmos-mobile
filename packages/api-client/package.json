{
  "name": "@taxikosmos/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the Laravel /api/v1 API (tokens, single-flight refresh, idempotency keys, tagged errors), the realtime socket with a polling fallback, and the TanStack Query hooks per resource.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./secure-store": "./src/secure-store.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.3",
    "@taxikosmos/core": "workspace:*",
    "socket.io-client": "4.8.4"
  },
  "peerDependencies": {
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "peerDependenciesMeta": {
    "expo-secure-store": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.16",
    "expo": "~57.0.30",
    "expo-secure-store": "~57.0.4",
    "jest": "29.7.0",
    "jest-expo": "~57.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
